NEXT_PUBLIC_SUPABASE_URL=your-supabase-project-url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key

# Keep false while building locally. Set to true when you want the dashboard
# to require Supabase sign-in.
NEXT_PUBLIC_REQUIRE_AUTH=false

# Optional: defaults to the public KTC sheet currently used by Owen's Hub.
KTC_GOOGLE_SHEET_ID=your-google-sheet-id
KTC_GOOGLE_SHEET_NAME=SF

# Obsidian Local REST API with MCP. Keep this server-only key private.
# Enable the plugin's HTTP server in Obsidian for the default local URL.
OBSIDIAN_API_URL=http://127.0.0.1:27123
OBSIDIAN_API_KEY=your-obsidian-local-rest-api-key

# Career Hub cloud automation. These are server-only secrets.
# CRON_SECRET protects the scheduled morning endpoint.
CRON_SECRET=make-a-long-random-secret
CAREER_INGEST_SECRET=make-another-long-random-secret

# Gmail API OAuth credentials for cloud job-alert imports.
GOOGLE_CLIENT_ID=your-google-oauth-client-id
GOOGLE_CLIENT_SECRET=your-google-oauth-client-secret
GMAIL_REFRESH_TOKEN=your-gmail-refresh-token
GMAIL_JOB_MAX_RESULTS=25
GMAIL_JOB_QUERY=newer_than:2d -in:spam -in:trash (from:linkedin.com OR from:indeed.com OR from:hiring.cafe OR from:hiringcafe.email) (job OR jobs OR alert OR hiring)
# Pokémon Restock Hub
BEST_BUY_API_KEY=
DISCORD_RESTOCK_WEBHOOK_URL=

# Pokemon Intelligence starts with manual data in Supabase.
# Run supabase/migrations/0006_jarvis_pokemon_intelligence.sql before using it.

# Optional: Pokemon TCG API key for higher catalog lookup rate limits.
# Light personal testing can work without a key.
POKEMON_TCG_API_KEY=

# Free server-side key from https://collegefootballdata.com/
# Used only by the Dynasty rookie public-data importer.
CFBD_API_KEY=
